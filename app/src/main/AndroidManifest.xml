<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Видимость всех приложений: поиску нужны любые, а плагины работают под UID хоста, и их
         собственные <queries> не действуют. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- Кнопки таймера и будильника в виджете TogglesPlugin. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- Чтение обоев для размытого фона (BlurredWallpaper). -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <application
        android:name=".SearchApp"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Search">
        <activity
            android:name=".SearchActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="stateAlwaysVisible|adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- SearchLinks. singleTask: ссылка приходит в уже открытый
                 поиск через onNewIntent, а не открывает второй. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="flexiblesearch" />
            </intent-filter>
        </activity>
    </application>

</manifest>
