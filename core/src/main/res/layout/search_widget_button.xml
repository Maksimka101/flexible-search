<?xml version="1.0" encoding="utf-8"?>
<!-- Кнопка плагина в виджете поиска: круг высотой со строку. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/search_widget_button"
    android:layout_width="52dp"
    android:layout_height="52dp"
    android:layout_marginStart="6dp"
    android:background="@drawable/search_widget_field">

    <!-- Векторная иконка: маска, красится по теме. -->
    <ImageView
        android:id="@+id/search_widget_button_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="center"
        android:importantForAccessibility="no"
        android:tint="@color/search_widget_icon"
        android:visibility="gone" />

    <!-- Картинка, например значок приложения: как есть. -->
    <ImageView
        android:id="@+id/search_widget_button_image"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="center"
        android:importantForAccessibility="no"
        android:visibility="gone" />
</FrameLayout>
